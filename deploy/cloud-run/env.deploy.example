GCP_PROJECT=fh-claw
GCP_REGION=us-central1
ARTIFACT_REGISTRY=clawhost
CLOUDSQL_INSTANCE=clawhost-db
API_SERVICE=clawhost-api
WEB_SERVICE=clawhost-web

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@/clawhost?host=/cloudsql/fh-claw:us-central1:clawhost-db
DATABASE_DRIVER=pg
NODE_ENV=production
PORT=8080

CLIENT=https://YOUR-WEB-SERVICE-URL.a.run.app
CORS_ALLOW_CLOUD_RUN=1

GCP_PROJECT_ID=fh-claw
GOOGLE_APPLICATION_CREDENTIALS=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

VITE_API_URL=https://YOUR-API-SERVICE-URL.a.run.app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
